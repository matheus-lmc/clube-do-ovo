generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Club {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(60)
  leaderId       String       @db.Uuid
  inviteCode     String       @unique @db.VarChar(6)
  bookVolumeId   String?
  bookTitle      String?
  bookAuthors    String?
  bookPublisher  String?
  bookYear       String?
  bookIsbn       String?      @db.VarChar(13)
  bookCover      String?
  bookPages      Int?
  chapterTotal   Int?
  chapterTitles  String[]     @default([])
  chapterSource  String?
  readingStartedAt DateTime?
  readingId        String? @db.Uuid
  comments         ReadingComment[]
  readingRevision  Int @default(0)
  createdAt      DateTime     @default(now())
  members        ClubMember[]
}

model ClubMember {
  clubId      String   @db.Uuid
  userId      String   @db.Uuid
  avatarUrl   String?
  displayName String   @db.VarChar(80)
  progress    Int?
  joinedAt    DateTime @default(now())
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
  @@index([userId])
}

model ReadingComment {
  id        String   @id @db.Uuid
  clubId    String   @db.Uuid
  readingId String   @db.Uuid
  authorId  String   @db.Uuid
  page      Int
  body      String   @db.VarChar(500)
  isSpoiler Boolean  @default(false)
  createdAt DateTime @default(now())
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId, readingId, page, createdAt, id])
}
